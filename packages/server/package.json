{
  "name": "@xiz-platform/server",
  "version": "0.13.1",
  "description": "Standalone headless XIZ Platform server (Bun runtime)",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "craft-server": "src/index.ts"
  },
  "files": [
    "src/"
  ],
  "engines": {
    "bun": ">=1.0.0"
  },
  "author": {
    "name": "Craft Docs Ltd.",
    "email": "support@craft.do"
  },
  "license": "Apache-2.0",
  "homepage": "https://github.com/xiz2680/xiz-platform",
  "scripts": {
    "start": "bun run src/index.ts",
    "generate-token": "bun run src/index.ts --generate-token",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@xiz-platform/core": "workspace:*",
    "@xiz-platform/messaging-gateway": "workspace:*",
    "@xiz-platform/server-core": "workspace:*",
    "@xiz-platform/shared": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.8.2",
    "@types/node": "^22.0.0",
    "ws": "^8.16.0"
  }
}
